# TrustLink Frontend Environment Variables
# Copy this file to `.env.local` for local development.
# Full documentation: ENV_VARS.md (and docs/ENV_VARS.md).
#
# Exposure rules:
#   - `NEXT_PUBLIC_*` variables are inlined into client JS bundles at build time.
#     NEVER put secrets or private tokens in `NEXT_PUBLIC_*` variables.
#   - Unprefixed variables are server-only and never exposed to browser bundles.

# ── Required (Validated by next.config.ts & env-validation.js) ──────────
# Backend API base URL (must point to the TrustLink API server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stellar smart contract ID used for escrow operations (56-char StrKey starting with C)
# Default public testnet contract ID. Update this for a custom contract deployment.
NEXT_PUBLIC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Stellar network identifier (testnet | mainnet | public; runtime falls back to testnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stellar network passphrase ("Test SDF Network ; September 2015" or "Public Global Stellar Network ; September 2015")
# Update this passphrase when deploying or using a custom network contract.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Optional: Soroban RPC ───────────────────────────────────────────────
# Soroban JSON-RPC endpoint (defaults to https://soroban-testnet.stellar.org)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Optional: Public URLs & SEO ─────────────────────────────────────────
# Canonical public site URL used in sitemap.xml, robots.txt, tracking metadata, and payment origin checks
NEXT_PUBLIC_SITE_URL=https://trustlink.app

# Application base URL used for Next.js metadataBase in app/layout.tsx
NEXT_PUBLIC_APP_URL=https://trustlink.app

# ── Optional: Analytics (PostHog) ───────────────────────────────────────
# PostHog project API key (leave empty to disable analytics)
NEXT_PUBLIC_POSTHOG_KEY=

# Set to "true" to disable PostHog analytics entirely (defaults to false)
NEXT_PUBLIC_POSTHOG_DISABLED=false

# ── Optional: Error Tracking & Performance (Sentry) ─────────────────────
# Sentry DSN for client, server, and edge error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry traces sample rate (0.0 to 1.0; defaults to 0.1 if unset or invalid)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Server/edge-only Sentry traces sample rate override (falls back to NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE, then 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Server-only secret: Sentry auth token for source map uploads during build (leave empty locally)
SENTRY_AUTH_TOKEN=

# ── Optional: Rate Limiting (Upstash Redis — Server-Only) ───────────────
# Server-only Upstash Redis REST URL (falls back to bounded in-memory limiter when unset)
UPSTASH_REDIS_REST_URL=

# Server-only secret: Upstash Redis REST token (required with UPSTASH_REDIS_REST_URL)
UPSTASH_REDIS_REST_TOKEN=

# Server-only: set to "true" to reject requests on Redis errors (defaults to false / fail-open)
RATE_LIMIT_FAIL_CLOSED=false

# ── Optional: Development & Mocking Flags ───────────────────────────────
# Set to "true" to make submitPayment() return a deterministic fake hash instead of hitting Soroban RPC.
# Enabled in .env.example for local convenience; set to "false" (or remove) for live testnet payments.
# Must NEVER be "true" in deployed/production environments.
NEXT_PUBLIC_ESCROW_MOCK_PAYMENTS=true

# Set to "true" to mock PaymentForm XDR generation and payment submission offline (defaults to false)
NEXT_PUBLIC_USE_MOCKS=false

# ── Optional: E2E / Test Runner & Runtime Variables ─────────────────────
# Uncomment only when running targeted test/build workflows; do not override NODE_ENV in .env.local.
# ENABLE_VISUAL_TEST_ROUTES=1
# STORYBOOK_URL=http://localhost:6006
# CI=true
# NODE_ENV=development
# NODE_OPTIONS=--max-old-space-size=4096
